## class
class Dataset:
   def __init__(self, name, rows):
     self.name = name
     self.rows = rows

   def __len__(self):
     return len(self.rows)

   def column(self, key):
     return [row[key] for row in self.rows]

   def __repr__(self):
     return f"Dataset({self.name!r}, {len(self)} rows)"

ds = Dataset("people", [{"name": "An", "age": 30}, {"name": "Binh", "age": 25}])
print(ds, len(ds), ds.column("age"))

## excer1
def is_palindrome(text):
  cleanTxt = ""
  for c in text:
    if c.isalpha() or c.isdigit():
      cleanTxt += c.lower()
  print(cleanTxt)
  result = True
  for i in range(int(len(cleanTxt)/2-1)): 
    if cleanTxt[i] != cleanTxt[len(cleanTxt)-i-1]:
      result = False
  return result

print(is_palindrome("A man, a plan, a canal: Panama")) 

## ex2 - wordcount
def word_count(txt):
  count = 0
  dict = {}
  word = ""
  for c in txt:
    if c.isalpha() or c.isdigit():
      word += c
    else:
      if word != "":
        dict[word] = dict.get(word, 0) + 1
      word = ""
  return dict

print(word_count("   the   cat and the   hat   "))

## ex3 - variance
def variance(values):
  mean = sum(values)/len(values)
  sd = 0
  for val in values:
    sd += (val - mean)**2
  variance = sd/len(values)
  return variance

print(variance([2,4,4,4,5,5,7,9]))

## ex4 - dot 2 list
def dot(nums1, nums2):
  result = 0
  for i in range(min(len(nums1), len(nums2))):
    result += nums1[i] * nums2[i]
  return result

print(dot([1,2,3],[4,5,6])) 

## ex5 - matmul
def matmul(a, b):
  # a [1,2]
  # a [3,4]
  # a [5,6]
  # b [7,8,9]
  # b [10,11,12]
  # a(3,2) x b (2,3) = c(2,2)
  # => len(a[1]) = len(b)
  if len(a) == 0 or len(b) == 0:
    return []
  if len(a[0]) != len(b):
    return []
  c = []
  for k in range(len(a)):
    r = []
    for i in range(len(a[0])):
      total = 0
      for j in range(len(a)):
        total += a[k][j] * b[j][i]
      r.append(total)
    c.append(r)
  return c

print(matmul([[1,2],[3,4]],[[5,6],[7,8]]))

