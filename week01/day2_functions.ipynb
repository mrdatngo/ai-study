## ex7 - norm
class Vector():
  def __init__(self, values):
    self.values = values

  def __add__(self, vector):
    result = []
    for i in range(len(self.values)):
      result.append(self.values[i] + vector.values[i])
    return Vector(result)

  def add(self, vector):
    result = []
    for i in range(len(self.values)):
      result.append(self.values[i] + vector.values[i])
    return Vector(result)

  def dot(self, other):
    result = 0
    for i in range(len(self.values)):
      result += self.values[i]*other.values[i]
    return result

  def norm(self):
    sumSquare = 0
    for i in range(len(self.values)):
      sumSquare += self.values[i]**2
    return sumSquare ** 0.5

  def __repr__(self):
    result = "["
    for i in range(len(self.values)):
      result += f"{self.values[i]} "
    result += "]"
    return result

vectorA = Vector([3,4])
vectorB = Vector([5,7])
print(vectorA.norm())
print(vectorA.dot(vectorB))
vectorA = vectorA.add(vectorA)
print(vectorA.norm())
print(vectorA)
print(vectorB)
print(vectorA + vectorB)
